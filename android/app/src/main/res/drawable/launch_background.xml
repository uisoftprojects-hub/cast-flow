<?xml version="1.0" encoding="utf-8"?>
<!-- No native splash artwork: just the same gradient the Flutter splash screen
     starts with, so the hand-over to Flutter is seamless (no white flash, no logo). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#6366F1"
                android:endColor="#4338CA" />
        </shape>
    </item>
</layer-list>
